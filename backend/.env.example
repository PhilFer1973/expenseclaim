# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...   # service_role key (NOT anon key — never ships to device)

# ── Storage ───────────────────────────────────────────────────────────────────
# Leave as "receipts" unless you created the bucket with a different name
RECEIPTS_BUCKET=receipts

# ── AI / LLM ──────────────────────────────────────────────────────────────────
# Anthropic API key — used for Claude Vision (receipt extraction),
# category suggestions, and narrative summarisation
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI key — used for text-embedding-3-small (1536-d vectors)
# Required for category suggestion kNN and duplicate detection
OPENAI_API_KEY=sk-...
